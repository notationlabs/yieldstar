{
  "name": "@yieldstar/sqlite-runtime",
  "version": "0.8.0",
  "license": "MIT",
  "author": "Daniel Grant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notationlabs/yieldstar.git",
    "directory": "packages/sqlite-runtime"
  },
  "engines": {
    "node": ">=22.6"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "import": "./dist/bun.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts src/bun.ts src/node.ts --outdir dist --target node --packages=external --splitting"
  },
  "dependencies": {
    "@yieldstar/core": "workspace:*",
    "pino": "^9.9.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "@types/node": "^22.18.0"
  }
}
